{
  "name": "hitch",
  "displayName": "Hitch",
  "version": "0.1.0",
  "private": true,
  "publisher": "leonardoacosta",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'test/**/*.test.ts'",
    "package": "vsce package --no-dependencies",
    "build:companion": "sh scripts/build-companion.sh",
    "check:vsix": "node scripts/check-vsix.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "activationEvents": [
    "onTerminalProfile:hitch.herdr",
    "onCommand:hitch.reattach",
    "onCommand:hitch.rebind"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Hitch spawns Herdr processes"
    }
  },
  "contributes": {
    "commands": [
      { "command": "hitch.reattach", "title": "Hitch: Reattach to Herdr Pane" },
      { "command": "hitch.rebind", "title": "Hitch: Rebind Project to New Herdr Workspace" }
    ],
    "terminal": {
      "profiles": [
        {
          "id": "hitch.herdr",
          "title": "Hitch Herdr"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leonardoacosta/hitch.git"
  },
  "license": "MIT",
  "extensionKind": [
    "workspace"
  ]
}
